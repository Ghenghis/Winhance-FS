<Window x:Class="Winhance.WPF.Features.Common.Views.VersionHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Winhance.WPF.Features.Common.Converters"
        x:Name="DialogWindow"
        Title="Version History &amp; Rollback"
        Width="650"
        Height="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        
        <!-- Version Item Template -->
        <DataTemplate x:Key="VersionItemTemplate">
            <Border Background="{DynamicResource CardBackground}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="15" 
                    Margin="0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Version Header -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding Version}" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Border Background="{DynamicResource SuccessBrush}" 
                                CornerRadius="4" 
                                Padding="5,2" 
                                Margin="10,0,0,0"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="CURRENT" 
                                       FontSize="10" 
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Border Background="{DynamicResource WarningBrush}" 
                                CornerRadius="4" 
                                Padding="5,2" 
                                Margin="10,0,0,0"
                                Visibility="{Binding IsStable, Converter={StaticResource InverseBooleanConverter}}">
                            <TextBlock Text="BETA" 
                                       FontSize="10" 
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Date -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="{Binding FormattedReleaseDate}" 
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,5,0,0"/>
                    
                    <!-- Description -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Grid.ColumnSpan="2"
                               Text="{Binding ReleaseNotes}" 
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="60"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0"/>
                    
                    <!-- Rollback Button -->
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Content="Rollback"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="90"
                            Height="32"
                            Visibility="{Binding CanRollbackTo, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="RollbackButton_Click"
                            Tag="{Binding Version}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.OpacityMask>
            <VisualBrush>
                <VisualBrush.Visual>
                    <Border Background="Black"
                            CornerRadius="10"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.OpacityMask>

        <Border CornerRadius="10"
                BorderThickness="0"
                BorderBrush="Transparent"
                Background="{DynamicResource WindowBackground}">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" LastChildFill="True" Style="{StaticResource DialogHeaderStyle}">
                    <TextBlock Text="📦 Version History &amp; Rollback"
                              Style="{StaticResource DialogTextBlockStyle}"
                              FontWeight="SemiBold"
                              FontSize="20"
                              VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Current Version Info -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current Version" 
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="CurrentVersionText"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="CheckUpdatesButton"
                                Content="Check for Updates"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="36"
                                Click="CheckUpdatesButton_Click"/>
                    </Grid>
                </Border>
                
                <!-- Version List -->
                <ScrollViewer Grid.Row="2" 
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,5">
                    <ItemsControl x:Name="VersionList"
                                  ItemTemplate="{StaticResource VersionItemTemplate}"/>
                </ScrollViewer>
                
                <!-- Loading Indicator -->
                <StackPanel Grid.Row="3" 
                            x:Name="LoadingPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Margin="0,10">
                    <ProgressBar IsIndeterminate="True" 
                                 Width="150" 
                                 Height="4"
                                 Style="{StaticResource StandardProgressBar}"/>
                    <TextBlock Text="Loading versions..." 
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                
                <!-- Error Message -->
                <TextBlock Grid.Row="3" 
                          x:Name="ErrorText"
                          Text=""
                          Foreground="{DynamicResource ErrorBrush}"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Visibility="Collapsed"
                          Margin="0,10"/>

                <!-- Footer -->
                <StackPanel Grid.Row="4" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">
                    <Button Content="Close"
                            Style="{StaticResource DialogButtonStyle}"
                            Click="CloseButton_Click"
                            Width="100"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
