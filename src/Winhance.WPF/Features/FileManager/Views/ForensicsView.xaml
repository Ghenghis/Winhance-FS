<UserControl x:Class="Winhance.WPF.Features.FileManager.Views.ForensicsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:viewModels="clr-namespace:Winhance.WPF.Features.FileManager.ViewModels"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" d:DataContext="{d:DesignInstance Type=viewModels:ForensicsViewModel}" mc:Ignorable="d">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Features/Common/Resources/Converters/Converters.xaml"/>
        <ResourceDictionary Source="/Features/Common/Resources/Styles/TableViewStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="SectionTabStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="ForensicsSections" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid>
                <Border x:Name="Hover" Background="{DynamicResource ButtonHoverBackground}" CornerRadius="4" Opacity="0" />
                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="4" Padding="12,6">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Hover" Property="Opacity" Value="0.35" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Target and checks -->
    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="15,10" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Check:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryTextColor}" />
          <TextBox Grid.Column="1" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" AutomationProperties.Name="File or folder to check" ToolTip="A file or folder (environment variables like %USERPROFILE% work)" />
          <Button Grid.Column="2" Content="Folder..." MinWidth="80" Height="30" Margin="8,0,0,0" Padding="10,0" Command="{Binding BrowseFolderCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
          <Button Grid.Column="3" Content="File..." MinWidth="70" Height="30" Margin="6,0,0,0" Padding="10,0" Command="{Binding BrowseFileCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
        </Grid>
        <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
          <Button Content="Find Hidden Streams" Width="Auto" MinWidth="110" Height="32" Padding="12,0" Margin="0,0,6,0" Command="{Binding ScanStreamsCommand}" ToolTip="List NTFS alternate data streams: download markers, hidden data and hidden programs (read-only)" Style="{DynamicResource PrimaryButtonStyle}" />
          <Button Content="Check Contents" Width="Auto" MinWidth="110" Height="32" Padding="12,0" Margin="0,0,6,0" Command="{Binding ScanContentCommand}" ToolTip="Find encrypted-looking files (ransomware), programs disguised as documents and wrong extensions (read-only)" Style="{DynamicResource PrimaryButtonStyle}" />
          <Button Content="Find Versions" Width="Auto" MinWidth="110" Height="32" Padding="12,0" Margin="0,0,6,0" Command="{Binding FindVersionsCommand}" ToolTip="Earlier copies of this file or folder kept in Windows snapshots (read-only)" Style="{DynamicResource PrimaryButtonStyle}" />
          <Button Content="Recycle Bin" Width="Auto" MinWidth="110" Height="32" Padding="12,0" Margin="0,0,12,0" Command="{Binding LoadRecycleBinCommand}" ToolTip="List deleted files you can put back" Style="{DynamicResource PrimaryButtonStyle}" />
          <CheckBox Content="Include subfolders" IsChecked="{Binding Recursive}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryTextColor}" />
          <CheckBox Content="List every file (not only suspicious)" IsChecked="{Binding ShowAllFiles}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryTextColor}" ToolTip="Applies to Check Contents" />
          <Button Content="Cancel" Height="32" Padding="10,0" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{DynamicResource SecondaryButtonStyle}" />
        </WrapPanel>
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <iconPacks:PackIconMaterial Kind="Magnify" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" MaxWidth="300" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Section switcher -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <RadioButton Style="{StaticResource SectionTabStyle}" IsChecked="{Binding IsStreamsSection, Mode=TwoWay}" AutomationProperties.Name="Hidden streams">
        <TextBlock Text="{Binding Streams.Count, StringFormat='Hidden Streams ({0})'}" FontWeight="SemiBold" />
      </RadioButton>
      <RadioButton Style="{StaticResource SectionTabStyle}" IsChecked="{Binding IsContentSection, Mode=TwoWay}" AutomationProperties.Name="Content check">
        <TextBlock Text="{Binding Inspections.Count, StringFormat='Content Check ({0})'}" FontWeight="SemiBold" />
      </RadioButton>
      <RadioButton Style="{StaticResource SectionTabStyle}" IsChecked="{Binding IsVersionsSection, Mode=TwoWay}" AutomationProperties.Name="Previous versions">
        <TextBlock Text="{Binding Versions.Count, StringFormat='Previous Versions ({0})'}" FontWeight="SemiBold" />
      </RadioButton>
      <RadioButton Style="{StaticResource SectionTabStyle}" IsChecked="{Binding IsRecycleSection, Mode=TwoWay}" AutomationProperties.Name="Recycle bin">
        <TextBlock Text="{Binding RecycleItems.Count, StringFormat='Recycle Bin ({0})'}" FontWeight="SemiBold" />
      </RadioButton>
    </StackPanel>

    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="12">
      <Grid>
        <!-- Hidden streams -->
        <Grid Visibility="{Binding IsStreamsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Margin="0,0,6,0" Content="Select Download Markers" Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding SelectDownloadMarkersCommand}" ToolTip="Zone.Identifier streams (removing them = 'Unblock' in file Properties)" />
            <Button Margin="0,0,6,0" Content="Select Hidden Data" Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding SelectHiddenDataCommand}" />
            <Button Content="Select None" Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding SelectNoStreamsCommand}" Margin="0,0,12,0" />
            <Button Margin="0,0,6,0" Content="Remove Selected..." Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding RemoveSelectedStreamsCommand}" ToolTip="Delete the ticked streams (the files themselves are untouched)" />
            <Button Margin="0,0,6,0" Content="Open Location" Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding OpenLocationCommand}" />
          </WrapPanel>
          <ListView Grid.Row="1" ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextColor}" ItemContainerStyle="{DynamicResource ThemedListViewItem}" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Hidden streams list">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="" Width="36">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Stream.StreamPath}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Kind" Width="175">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding KindColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding KindText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="File" Width="230">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Stream.FilePath}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Stream" Width="170" DisplayMemberBinding="{Binding Stream.StreamName}" />
                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="What it is" Width="520">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Stream.Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Stream.Description}" Foreground="{DynamicResource SubTextColor}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <Border Grid.Row="2" Margin="0,8,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource MainContainerBorderBrush}" MinHeight="70" MaxHeight="140">
            <StackPanel>
              <TextBlock Text="{Binding SelectedStream.Stream.StreamPath, StringFormat='Contents of {0}'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryTextColor}" />
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100" Margin="0,4,0,0">
                <TextBlock Text="{Binding StreamPreview}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource SubTextColor}" AutomationProperties.Name="Stream contents" />
              </ScrollViewer>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Streams.Count, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Invert}">
            <iconPacks:PackIconMaterial Kind="Incognito" Width="56" Height="56" Foreground="{DynamicResource SubTextColor}" HorizontalAlignment="Center" />
            <TextBlock Text="Click 'Find Hidden Streams' to list data hidden behind files (NTFS alternate data streams)" FontSize="15" Margin="0,12,0,0" Foreground="{DynamicResource SubTextColor}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- Content check -->
        <Grid Visibility="{Binding IsContentSection, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListView Grid.Row="0" ItemsSource="{Binding Inspections}" SelectedItem="{Binding SelectedInspection}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextColor}" ItemContainerStyle="{DynamicResource ThemedListViewItem}" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Content check results">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Verdict" Width="160">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding VerdictColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VerdictText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="File" Width="230">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Inspection.Path}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Real type" Width="190" DisplayMemberBinding="{Binding DetectedText}" />
                <GridViewColumn Header="Entropy" Width="130">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Width="112">
                        <ProgressBar Value="{Binding EntropyPercent, Mode=OneWay}" Maximum="100" Height="14" Opacity="0.6" />
                        <TextBlock Text="{Binding EntropyText}" HorizontalAlignment="Center" FontSize="11" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="Why" Width="520">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Inspection.Reason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Inspection.Reason}" Foreground="{DynamicResource SubTextColor}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Inspections.Count, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Invert}">
            <iconPacks:PackIconMaterial Kind="ShieldSearch" Width="56" Height="56" Foreground="{DynamicResource SubTextColor}" HorizontalAlignment="Center" />
            <TextBlock Text="Click 'Check Contents' to find encrypted-looking files and programs disguised as documents" FontSize="15" Margin="0,12,0,0" Foreground="{DynamicResource SubTextColor}" HorizontalAlignment="Center" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Margin="0,0,6,0" Content="Open Location" Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding OpenLocationCommand}" />
            <TextBlock Text="Entropy measures randomness: 8.00 means indistinguishable from random (compressed or encrypted). Text and documents score far lower." VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SubTextColor}" />
          </WrapPanel>
        </Grid>

        <!-- Previous versions -->
        <Grid Visibility="{Binding IsVersionsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding VersionsNote}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource SubTextColor}" />
            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
              <Button Margin="0,0,6,0" Content="Restore a Copy..." Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding RestoreVersionCopyCommand}" ToolTip="Save the selected version next to the original (the current file is not touched)" />
              <Button Margin="0,0,6,0" Content="Replace Current..." Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding ReplaceWithVersionCommand}" ToolTip="Overwrite the current file with the selected version (asks first)" />
            </WrapPanel>
            <ListView Grid.Row="2" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextColor}" ItemContainerStyle="{DynamicResource ThemedListViewItem}" AutomationProperties.Name="Previous versions list">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Snapshot taken" Width="160" DisplayMemberBinding="{Binding SnapshotTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                  <GridViewColumn Header="File modified" Width="160" DisplayMemberBinding="{Binding Modified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                  <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                  <GridViewColumn Header="Compared with now" Width="160" DisplayMemberBinding="{Binding StateText}" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
          <Border Grid.Column="1" Margin="12,0,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource MainContainerBorderBrush}">
            <StackPanel>
              <TextBlock Text="Snapshots per drive" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Protection}" AutomationProperties.Name="Snapshots per drive">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                      <TextBlock Text="{Binding VolumeRoot}" Width="50" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" />
                      <TextBlock Text="{Binding SnapshotCount, StringFormat='{}{0} snapshot(s)'}" Width="100" Foreground="{DynamicResource SubTextColor}" />
                      <TextBlock Text="{Binding Newest, StringFormat='newest {0:yyyy-MM-dd}', TargetNullValue='protection off'}" Foreground="{DynamicResource SubTextColor}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="System Protection..." HorizontalAlignment="Left" Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,10,0,0" Command="{Binding OpenSystemProtectionCommand}" ToolTip="Open Windows System Protection to turn snapshots on for a drive and create a restore point" />
              <TextBlock Text="Snapshots are made by System Restore, Windows Update and backup tools. Previous versions only exist for files that were on a protected drive when a snapshot was taken." TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource SubTextColor}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Recycle Bin -->
        <Grid Visibility="{Binding IsRecycleSection, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource PrimaryTextColor}" />
            <TextBox Text="{Binding RecycleFilter, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="28" VerticalContentAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Filter deleted items" />
            <Button Margin="0,0,6,0" Content="Restore" Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding RestoreRecycledCommand}" ToolTip="Put the ticked items back where they were (never overwrites)" />
            <Button Margin="0,0,6,0" Content="Restore To..." Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding RestoreRecycledToFolderCommand}" ToolTip="Put the ticked items into a folder you choose" />
            <Button Margin="0,0,6,0" Content="Refresh" Style="{DynamicResource SecondaryButtonStyle}" Height="28" Padding="10,0" Command="{Binding LoadRecycleBinCommand}" />
          </WrapPanel>
          <ListView Grid.Row="1" ItemsSource="{Binding RecycleView}" SelectedItem="{Binding SelectedRecycleItem}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextColor}" ItemContainerStyle="{DynamicResource ThemedListViewItem}" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Recycle bin items">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="" Width="36">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Item.OriginalPath}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Name" Width="240">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.OriginalPath}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Was in" Width="460">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding OriginalFolder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalFolder}" Foreground="{DynamicResource SubTextColor}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Deleted" Width="150" DisplayMemberBinding="{Binding Deleted, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                <GridViewColumn Header="Size" Width="140" DisplayMemberBinding="{Binding SizeText}" />
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding RecycleItems.Count, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=Invert}">
            <iconPacks:PackIconMaterial Kind="DeleteRestore" Width="56" Height="56" Foreground="{DynamicResource SubTextColor}" HorizontalAlignment="Center" />
            <TextBlock Text="Nothing to restore: the Recycle Bin is empty (or click 'Recycle Bin' to read it)" FontSize="15" Margin="0,12,0,0" Foreground="{DynamicResource SubTextColor}" HorizontalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubTextColor}" Text="Files removed with Shift+Delete, or after emptying the bin, are not listed here; look for them in Previous Versions. Raw disk recovery of overwritten space is not included." />
        </Grid>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{DynamicResource MainContainerBorderBrush}" CornerRadius="8" Padding="15,10" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource SubTextColor}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
          <iconPacks:PackIconMaterial Kind="Loading" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Spin="True" Margin="0,0,8,0" />
          <TextBlock Text="Working..." FontSize="14" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
